{
  "manifest_version": 3,
  "name": "Legislação Direta - Planalto",
  "version": "1.1.0",
  "description": "Abre normas federais diretamente no Portal da Legislação da Presidência da República.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://portaldalegislacao.presidencia.gov.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Buscar legislação (Alt+L)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "omnibox": {
    "keyword": "lei"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Abrir busca rápida de legislação"
    }
  }
}